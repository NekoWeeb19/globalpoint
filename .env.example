# StarPoint settings. setup.bat copies this to .env on first run; edit .env, not this file.
# LISTEN_HOST 127.0.0.1 keeps the server (and its dashboard) to this machine: an emulator reaches it
# through "adb reverse tcp:8000 tcp:8000". Use 0.0.0.0 only to let other devices on your network in.

CDN_DIR=".cdn"
LISTEN_HOST="127.0.0.1"
LISTEN_PORT="8000"
BANNER_ROTATION="false"
BANNER_ROTATION_HOURS="24"
# Raid Event (Sagas of Conquest), single-player: how many clears of a raid's hardest stage defeat its boss once.
# Easier stages count by their kill weight. Raids 1-3 pay their rewards over 5-10 boss kills.
RAID_SOLO_CLEARS_PER_KILL="1"

# Co-op (multiplayer with COM partners). The game connects straight to this PC for the battle, so
# COOP_HOST must be this PC's address as your phone sees it (leave empty to detect it automatically).
# COOP_MANA_NODE_FORMAT: "list" (what the global game sends) or "map" (the Chinese fork's format).
# The co-op server listens on LISTEN_HOST too (set COOP_LISTEN_HOST to override it).
COOP_HOST=""
COOP_PORT="18888"
COOP_MANA_NODE_FORMAT="list"
# COOP_SUMMON_SECONDS: after you press Recruit, how many seconds the game waits before your COM partners join.
COOP_SUMMON_SECONDS="5"
# LOGIN_BONUS_PAID_BEADS: paid beads added every day with the everyday login bonus, on top of its own rewards (0 turns it off).
LOGIN_BONUS_PAID_BEADS="150"

SERVER_TIME_TICKS="true"
# SERVER_START_DATE: the game date a new install starts at (only when there's no saved clock yet; change
# the date on the dashboard after that). 2021-07-24 05:00 UTC: the Launch Gala Portal, where the regular
# banner rotation begins (before it only the 4 permanent portals are listed).
SERVER_START_DATE="2021-07-24T05:00:00Z"

# CN client (src/lib/cnClient.ts): the account it plays on (empty = each device gets its own account), the CN game
# files and their English tables (relative paths are from this folder)
CN_ACCOUNT_ID=""
CN_CDN_DIR=".cdn/cn"
CN_TRANSLATED_DIR=".cdn/cn_text"
