  "production/upload/6b/ef338822b2c963eb40c67b3d43a3b3f911ad73": {
   "300001/1": {
    "0:2": [
     "アスタ、異世界へ",
     "阿斯塔，前往异世界"
    ],
    "0:127": [
     "迷宮で怪我人を背に防衛を続けていたアルク達は、異世界からの来訪者である『アスタ』、『ユノ』、『ノエル』と出会う。協力して迷宮から脱出し、アスタ達にここが異世界である旨を説明していたアルク達は、急報を受けて共にドラゴンの討伐に向かう",
     "在迷宫中护着伤员持续防守的阿尔克一行人，遇见了来自异世界的访客『阿斯塔』、『尤诺』和『诺艾尔』。众人合力逃出迷宫，正当阿尔克一行人向阿斯塔他们说明这里是异世界时，收到了紧急消息，便一同前去讨伐巨龙。"
    ]
   },
   "300001/2": {
    "0:2": [
     "訳ありの村",
     "有隐情的村庄"
    ],
    "0:127": [
     "ドラゴンに襲われていた少年を救ったアルク達は、少年の住む村へと向かい避難の準備を要請するも断られてしまう。パルペブラを敵視し救援を拒む村長を見かねたアルク達は、村のみんなを護るべくギルドへの報告組と村の防衛組の二組に分かれて行動を開始する",
     "救下遭巨龙袭击的少年后，阿尔克一行人前往少年居住的村庄，请村民做好避难准备，却遭到了拒绝。看不下去敌视帕尔佩布拉、拒绝救援的村长，阿尔克一行人为了保护全村的人，分成向公会报告的小组和守卫村庄的小组，开始行动。"
    ]
   },
   "300001/3": {
    "0:2": [
     "ドラゴンハザード",
     "巨龙危机"
    ],
    "0:127": [
     "村に残り村人達への説得を続けていたアスタ達は、ドラゴンから助けた少年にこの村の成り立ちを聞く。そして全てを諦めている村長を叱咤したアスタは、アルク達と共に村に来襲したドラゴンから村の防衛を続け、合流したノエルと共に大型ドラゴンに立ち向かう",
     "留在村中继续说服村民的阿斯塔一行人，从他们救下的少年口中得知了这座村庄的由来。阿斯塔斥责了放弃一切的村长，与阿尔克一行人一同继续抵御来袭的巨龙、守护村庄，并与赶来会合的诺艾尔一起迎战大型巨龙。"
    ]
   },
   "300001/4": {
    "0:2": [
     "ブラックドラゴン ::quest_rank::",
     "黑龙 ::quest_rank::"
    ]
   },
   "300001/5": {
    "0:2": [
     "諦めの悪い男",
     "不肯放弃的男人"
    ],
    "0:127": [
     "駆け付けた冒険者に村の防衛を任せて、騒動の黒幕である黒衣の魔術師を撃退したアスタ達。後日、少年とギルドに訪れたアスタ達は、パルペブラの一部として認められたあの村の処遇を喜び、今しばらくアルク達と共に協力し合うことを決めるのだった",
     "将村庄的防守交给赶来的冒险者后，阿斯塔一行人击退了这场骚动的幕后黑手——黑衣魔术师。几天后，阿斯塔一行人和少年一同造访公会，为那座村庄被认可为帕尔佩布拉的一部分而高兴，并决定暂时继续与阿尔克一行人互相协助。"
    ]
   },
